{
  "name": "github-issues-mcp",
  "version": "2.11.0",
  "private": true,
  "scripts": {
    "deploy": "npm run db:migrate && wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "oxlint src/ test/",
    "format": "oxfmt src/ test/",
    "check": "npm run lint && npm run type-check",
    "db:migrate": "wrangler d1 migrations apply github-issues-mcp --remote",
    "db:migrate:local": "wrangler d1 migrations apply github-issues-mcp --local",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "^0.34.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
